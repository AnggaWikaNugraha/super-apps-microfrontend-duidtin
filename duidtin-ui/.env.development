# Dibaca HANYA saat `next dev` — build produksi di Vercel memakai env project-nya.
#
# Bawaan dev: semua remote diambil dari versi publish (Vercel) lewat rewrites di
# next.config.mjs. Yang sedang dikerjakan diarahkan ke laptop per remote:
#   localhost:3000/?remote-lokal=duidtin_feature_rekening@3005
#
# Mau semuanya lokal (tiap remote di port-nya sendiri + API :4000)? Timpa di
# .env.local — file itu menang atas file ini dan tidak ikut di-commit:
#   NEXT_PUBLIC_REMOTE_DARI=lokal
#   NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REMOTE_DARI=publish

# Remote auth yang publish memanggil API produksi, jadi sesinya juga milik API
# produksi — host harus memanggil API yang sama.
NEXT_PUBLIC_API_URL=https://super-apps-duidtin-api-eta.vercel.app

REMOTE_DESIGN_SYSTEM_URL=https://super-apps-duidtin-ui-system.vercel.app
REMOTE_LAYOUT_URL=https://super-apps-duidtin-ui-layout.vercel.app
REMOTE_AUTH_URL=https://super-apps-duidtin-feature-auth.vercel.app
# URL project beranda tidak tercatat; diteruskan lewat host produksi yang sudah
# punya rewrite /beranda/* sendiri.
REMOTE_BERANDA_URL=https://super-apps-duidtin.vercel.app
REMOTE_REKENING_URL=https://super-apps-duidtin-feature-rekening.vercel.app
