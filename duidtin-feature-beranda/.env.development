# Dibaca HANYA saat `rsbuild dev`. Bundle ini memanggil configureAuth() sendiri,
# jadi harus menunjuk API yang sama dengan host — bawaan dev host memakai API
# produksi (lihat duidtin-ui/.env.development).
#
# Host dijalankan full lokal? Timpa di .env.local:
#   PUBLIC_API_URL=http://localhost:4000
PUBLIC_API_URL=https://super-apps-duidtin-api-eta.vercel.app
