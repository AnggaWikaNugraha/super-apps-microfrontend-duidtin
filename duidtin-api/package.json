{
  "name": "duidtin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch scripts/dev.ts",
    "db:lokal": "bun run scripts/db-lokal.ts",
    "seed": "bun run scripts/seed.ts",
    "test": "bun test --timeout 120000",
    "check-types": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build:node": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "8.24.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "10.4.3",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  }
}
